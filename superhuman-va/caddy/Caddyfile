# Caddyfile — Superhuman VA reverse proxy
#
# Terminates self-signed TLS on the Oracle public IP, then routes:
#   /         → next-app:3000       (chat UI, Next.js API routes live here)
#   /pb/*     → pocketbase:8090     (admin UI at /pb/_/, REST at /pb/api/*)
#   /ms/*     → memory-service:8000 (Swagger at /ms/docs, OpenAPI at /ms/openapi.json)
#   /healthz  → static "ok" response (external uptime checks)
#
# Qdrant stays internal — never proxied.

{
    # We're IP-only with a static cert; do NOT attempt ACME.
    auto_https off
    admin off
    # Quiet the default log format a little.
    log default
}

# ── HTTP → HTTPS redirect ────────────────────────────
:80 {
    redir https://{host}{uri} permanent
}

# ── HTTPS termination with self-signed cert ──────────
:443 {
    tls /etc/caddy/cert.pem /etc/caddy/key.pem

    encode gzip zstd

    # PocketBase admin UI + REST API under /pb/*
    @pb path /pb /pb/*
    handle @pb {
        uri strip_prefix /pb
        reverse_proxy pocketbase:8090 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }

    # Memory-service Swagger + OpenAPI under /ms/*
    @ms path /ms /ms/*
    handle @ms {
        uri strip_prefix /ms
        reverse_proxy memory-service:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }

    # Public health endpoint
    @health path /healthz
    handle @health {
        respond "ok\n" 200
    }

    # Default: chat UI (and Next.js API routes: /api/chat, /api/upload, /api/memories, /api/conversations)
    handle {
        reverse_proxy next-app:3000 {
            # Streaming chat needs these to flush immediately.
            flush_interval -1
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }

    # Friendly error if a backend is down
    handle_errors {
        respond "{err.status_code} {err.status_text}\n" {err.status_code}
    }
}
