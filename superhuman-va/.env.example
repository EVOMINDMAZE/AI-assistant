# ── LLM ──────────────────────────────────────────────
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-replace-me

# ── App-level identity (single-user MVP) ──────────────
# Every Mem0/PocketBase record is scoped to this user_id.
USER_ID=local-user

# ── PocketBase admin (created on first run) ───────────
# Visit http://localhost:8090/_/ and create the superuser,
# OR pre-set these before `docker compose up` and the
# bootstrap script will use them.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=admin-password-change-me

# ── Memory service internals ──────────────────────────
# Where HF / fastembed caches downloaded models.
HF_HOME=/app/.cache/huggingface
# Embedding model must match the Qdrant vector dims (384).
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIMS=384

# ── Network ports (host-side) ─────────────────────────
PB_PORT=8090
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
MEMORY_PORT=8000
NEXT_PORT=3000
