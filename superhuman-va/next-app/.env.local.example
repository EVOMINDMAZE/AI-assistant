# ── Next.js ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Memory service (Docker internal hostname) ────────
# When running `npm run dev` on the host (not inside Docker), use
# http://localhost:8000 instead of http://memory-service:8000.
MEMORY_SERVICE_URL=http://localhost:8000

# ── PocketBase ────────────────────────────────────────
NEXT_PUBLIC_PB_URL=http://localhost:8090
# Server-side only — used for admin operations from API routes.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=admin-password-change-me

# ── LLM ───────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Identity (single-user MVP) ────────────────────────
USER_ID=local-user
