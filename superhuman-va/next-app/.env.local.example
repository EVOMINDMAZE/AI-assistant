# ── Next.js ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Memory service (Docker internal hostname) ────────
# When running `npm run dev` on the host (not inside Docker), use
# http://localhost:8000 instead of http://memory-service:8000.
MEMORY_SERVICE_URL=http://localhost:8000

# ── PocketBase ────────────────────────────────────────
NEXT_PUBLIC_PB_URL=http://localhost:8090
# Server-side only — used for admin operations from API routes.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=admin-password-change-me

# ── LLM ───────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ── Researcher (Tavily web search) ───────────────────
# Free tier: 1000 searches/month. Get a key at https://tavily.com
TAVILY_API_KEY=tvly-replace-me

# ── Auth (single shared password) ────────────────────
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
APP_PASSWORD_HASH=$2a$10$replace-with-bcrypt-hash

# ── App password (used by /api/chat for AUTH check) ──
# Plain text password; compared against APP_PASSWORD_HASH
APP_PASSWORD=replace-me

# ── Cost observability ───────────────────────────────
# V4 Pro pricing (May 2026, USD per 1M tokens)
COST_INPUT_PER_M=1.74
COST_OUTPUT_PER_M=0.55
COST_REASONING_PER_M=4.40

# ── Identity (single-user MVP) ────────────────────────
USER_ID=local-user
