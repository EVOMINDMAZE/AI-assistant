# ── Next.js ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────
# Get these from your Supabase project's API Settings.
# NEXT_PUBLIC_* are exposed to the browser; safe to ship.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service-role key — SERVER-ONLY, never expose to the browser.
# Has full DB access (bypasses RLS). Use only in API route handlers
# and server actions where the user_id is verified.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── LLM ───────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ── Researcher (Tavily web search) ───────────────────
# Free tier: 1000 searches/month. Get a key at https://tavily.com
TAVILY_API_KEY=tvly-replace-me

# ── Vercel cron auth ─────────────────────────────────
# Used by app/api/cron/cleanup/route.ts. Generate a random 32+ char string.
CRON_SECRET=replace-with-random-32+-chars

# ── Cost observability ───────────────────────────────
# V4 Pro pricing (May 2026, USD per 1M tokens)
COST_INPUT_PER_M=1.74
COST_OUTPUT_PER_M=0.55
COST_REASONING_PER_M=4.40

# ── Identity (single-user MVP, kept for back-compat) ─
USER_ID=local-user
